generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  googleId       String   @unique
  fullName       String
  email          String   @unique
  profilePicture String?
  dob            DateTime?
  position       String?  // "Student" or "Employee"
  company        String?  // Optional for Student, required for Employee
  
  sessions       Session[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique // JWT cookie token fallback if we want to store it in DB
  expiresAt DateTime
  createdAt DateTime @default(now())
}
